APP_NAME="DBENA Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY
APP_TIMEZONE=Asia/Kuala_Lumpur

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dbena_dashboard
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Emel ──────────────────────────────────────────────────────────────
# "log" menulis emel ke storage/logs/laravel.log dan TIDAK menghantar
# apa-apa. Sesuai untuk pembangunan; di server ia bermakna kod OTP tidak
# pernah sampai kepada sesiapa.
#
# Untuk server, tukar kepada SMTP. Contoh Gmail (perlu App Password,
# bukan kata laluan Gmail biasa — lihat PANDUAN_EMEL_OTP.md):
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=dbenareport@gmail.com
#   MAIL_PASSWORD="abcd efgh ijkl mnop"
#   MAIL_ENCRYPTION=tls
#
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="dbenareport@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Peti masuk berpusat untuk kod OTP (bukan emel peribadi pengguna).
# Kosongkan untuk menghantar ke emel peribadi setiap pengguna.
DBENA_OTP_INBOX_ADMIN=dbenareport@gmail.com
DBENA_OTP_INBOX_USER=dbenagroup@gmail.com

# Tetapan khusus DBENA
DBENA_OTP_TTL_MINUTES=5
DBENA_OTP_MAX_ATTEMPTS=3
DBENA_OTP_RESEND_COOLDOWN=60
DBENA_LOGIN_MAX_ATTEMPTS=5
DBENA_LOGIN_DECAY_MINUTES=15
DBENA_PROFIT_MARGIN=0.18
DBENA_SERVICE_STATUS_THRESHOLD=35
DBENA_FISCAL_YEAR_END_MONTH=12

# ── Integrasi Google Sheet ────────────────────────────────────────────────
# 'link'    = sheet dikongsi "anyone with the link can view" (tiada kunci perlu)
# 'service' = service account Google Cloud (untuk sheet peribadi)
DBENA_SHEETS_DRIVER=link
DBENA_SHEETS_SYNC_MINUTES=15
DBENA_SHEETS_TIMEOUT=20
DBENA_SHEETS_MAX_BYTES=5242880
DBENA_SHEETS_LOG_DAYS=60

# Hanya jika DBENA_SHEETS_DRIVER=service
#
# Cara paling mudah di Forge: enkod fail kunci JSON ke base64 dan tampal
# keseluruhannya sebagai SATU baris di sini. Tiada muat naik fail diperlukan.
#   Windows : [Convert]::ToBase64String([IO.File]::ReadAllBytes("kunci.json"))
#   Mac/Linux: base64 -w0 kunci.json
# GOOGLE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...
#
# Alternatif: fail sebenar pada cakera
# GOOGLE_SERVICE_ACCOUNT_JSON=/home/forge/site/storage/app/google/service-account.json
